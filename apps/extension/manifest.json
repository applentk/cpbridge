{
  "manifest_version": 3,
  "name": "cpbridge Submission Bridge",
  "version": "1.0.4",
  "description": "Zero-cookie browser session bridge for cpbridge submissions",
  "permissions": [
    "cookies",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://codeforces.com/*",
    "https://atcoder.jp/*",
    "http://localhost:3000/*",
    "http://localhost:5173/*",
    "http://localhost:4173/*",
    "http://localhost:8080/*",
    "http://127.0.0.1:3000/*",
    "http://127.0.0.1:5173/*",
    "http://127.0.0.1:4173/*",
    "http://127.0.0.1:8080/*",
    "https://*.applentk.com/*",
    "https://*.vercel.app/*",
    "https://cpbridge.applentk.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "http://localhost:5173/*",
        "http://localhost:4173/*",
        "http://localhost:8080/*",
        "http://127.0.0.1:3000/*",
        "http://127.0.0.1:5173/*",
        "http://127.0.0.1:4173/*",
        "http://127.0.0.1:8080/*",
        "https://*.applentk.com/*",
        "https://*.vercel.app/*",
        "https://cpbridge.applentk.com/*"
      ],
      "js": ["dist/bridge.js"],
      "run_at": "document_start"
    }
  ]
}
