{
  "name": "@cpbridge/extension",
  "version": "1.0.11",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --mode development --watch",
    "sync-version": "node scripts/sync-version.mjs",
    "predev": "pnpm sync-version",
    "prebuild": "pnpm sync-version",
    "prepackage": "pnpm sync-version",
    "precheck": "pnpm sync-version",
    "build": "vite build && node scripts/package.js",
    "package": "vite build && node scripts/package.js",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vite build --config vite.test.config.ts && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@cpbridge/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/chrome": "^0.0.308",
    "archiver": "^8.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.1"
  }
}
