{
  "name": "cpbridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "cd apps/api && set -a && . ./.env && set +a && if PATH=\"$PATH:$(go env GOPATH 2>/dev/null || echo $HOME/go)/bin\" which air >/dev/null 2>&1; then PATH=\"$PATH:$(go env GOPATH 2>/dev/null || echo $HOME/go)/bin\" air; else go run cmd/server/main.go; fi",
    "seed:demo": "cd apps/api && go run ./cmd/seed-demo",
    "dev:web": "pnpm --filter @cpbridge/web dev",
    "dev:ext": "pnpm --filter @cpbridge/extension dev",
    "package:ext": "pnpm --filter @cpbridge/extension package",
    "build": "pnpm --recursive run build",
    "test:api": "cd apps/api && go test -v ./...",
    "test:extension": "pnpm --filter @cpbridge/extension test",
    "test:web": "pnpm --filter @cpbridge/web test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "pnpm --recursive run check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0"
  }
}
